# Server
NODE_ENV=production
# Populate only after verifying the ingress chain; never use a global /0 range.
TRUST_PROXY_CIDRS=
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=https://merigf.com

# Internal service auth. Keep this secret on the backend only.
SUBSCRIPTIONS_API_KEY=replace_with_a_long_random_secret
# Disabled unless set to one operator-approved Eva account ID. Grants expire in 24h.
TEST_ACCESS_USER_ID=
# Dedicated Play reviewer demo account only. Blank disables review access.
# No purchases or financial records are created; normal daily/monthly limits apply.
PLAY_REVIEW_USER_ID=

# MongoDB
MONGODB_URI=mongodb://user:password@host:27017/eva_subscriptions
MONGODB_DATABASE=eva_subscriptions

# Eva plan limits
PLAN_ID=eva_premium_monthly
PLAN_NAME=Eva Premium Monthly
PLAN_AMOUNT=49900
PLAN_CURRENCY=INR
PLAN_INTERVAL=monthly
FREE_MESSAGE_LIMIT=10
PAID_DAILY_MESSAGE_LIMIT=100

# Google Play Billing. Use this for Play Store-distributed Android digital subscriptions.
GOOGLE_PLAY_PACKAGE_NAME=com.eva.ai
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=eva_premium_monthly
GOOGLE_PLAY_BASE_PLAN_ID=monthly
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_RTDN_TOKEN=replace_with_a_long_random_secret
# Recommended: authenticated Pub/Sub push, without a token in the URL.
GOOGLE_PLAY_RTDN_AUDIENCE=
# Set the audience to https://billing.merigf.com/api/v1/webhooks/google-play/rtdn
# together with the authenticated push service account below.
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_ALTERNATIVE_BILLING_ENABLED=false
# Configure from your actual tax treatment before testing alternative billing.
GOOGLE_PLAY_TAX_RATE_BPS=0
GOOGLE_PLAY_TAX_REGION=IN

# Durable post-payment confirmation queue. The worker POSTs a signed internal
# confirmation to this URL after entitlement persistence succeeds.
PAYMENT_CONFIRMATION_URL=https://api.merigf.com/internal/payment-confirmation
PAYMENT_CONFIRMATION_TOKEN=
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=subscriptions_payments
QUEUE_WORKER_CONCURRENCY=2
# The API runs a MongoDB polling worker by default. Set false only if a
# separate npm run start:worker process is deployed and monitored.
QUEUE_WORKER_ENABLED=true
QUEUE_POLL_INTERVAL_MS=5000
QUEUE_BATCH_SIZE=10
QUEUE_MAX_ATTEMPTS=8
QUEUE_RETRY_BASE_SECONDS=60
QUEUE_RETRY_MAX_SECONDS=1800
QUEUE_LEASE_SECONDS=300
RECONCILIATION_INTERVAL_SECONDS=900

# Razorpay. Use only for web/outside-Play flows where Google Play Billing policy permits it.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTION_PLAN_ID=plan_TgMvWQzlmT0eVZ
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120

# Preserve the previous merchant for historical untagged subscription rows.
# Set all legacy fields together when changing the primary merchant.
RAZORPAY_LEGACY_KEY_ID=
RAZORPAY_LEGACY_KEY_SECRET=
RAZORPAY_LEGACY_WEBHOOK_SECRET=
RAZORPAY_LEGACY_PLAN_ID=
RAZORPAY_LEGACY_PLAN_AMOUNT=49900
RAZORPAY_LEGACY_PLAN_CURRENCY=INR

# Optional one-rupee Live Mode verification: one cycle, exact immutable Eva user ID.
# Never use this plan as the public RAZORPAY_SUBSCRIPTION_PLAN_ID.
RAZORPAY_LIVE_TEST_PLAN_ID=
RAZORPAY_LIVE_TEST_USER_ID=
