# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=https://merigf.com

# Internal service auth. Keep this secret on the backend only.
SUBSCRIPTIONS_API_KEY=replace_with_a_long_random_secret

# MongoDB
MONGODB_URI=mongodb://user:password@host:27017/eva_subscriptions
MONGODB_DATABASE=eva_subscriptions

# Eva plan limits
PLAN_ID=eva_premium_monthly
PLAN_NAME=Eva Premium Monthly
PLAN_AMOUNT=49900
PLAN_CURRENCY=INR
PLAN_INTERVAL=monthly
FREE_MESSAGE_LIMIT=10
PAID_DAILY_MESSAGE_LIMIT=100

# Google Play Billing. Use this for Play Store-distributed Android digital subscriptions.
GOOGLE_PLAY_PACKAGE_NAME=com.eva.ai
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=eva_premium_monthly
GOOGLE_PLAY_BASE_PLAN_ID=monthly
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_RTDN_TOKEN=replace_with_a_long_random_secret
GOOGLE_PLAY_ALTERNATIVE_BILLING_ENABLED=false
# Configure from your actual tax treatment before testing alternative billing.
GOOGLE_PLAY_TAX_RATE_BPS=0
GOOGLE_PLAY_TAX_REGION=IN

# Durable post-payment confirmation queue. The worker POSTs a signed internal
# confirmation to this URL after entitlement persistence succeeds.
PAYMENT_CONFIRMATION_URL=
PAYMENT_CONFIRMATION_TOKEN=
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=subscriptions_payments
QUEUE_WORKER_CONCURRENCY=2
QUEUE_POLL_INTERVAL_MS=5000
QUEUE_BATCH_SIZE=10
QUEUE_MAX_ATTEMPTS=8
QUEUE_RETRY_BASE_SECONDS=60
QUEUE_RETRY_MAX_SECONDS=1800
QUEUE_LEASE_SECONDS=300

# Razorpay. Use only for web/outside-Play flows where Google Play Billing policy permits it.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTION_PLAN_ID=plan_TRv3HKpujDyFoS
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
